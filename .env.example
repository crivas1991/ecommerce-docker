# =============================================================================
# Variables del ecosistema (docker compose las lee de .env en esta carpeta)
#   cp .env.example .env
# =============================================================================

# --- Base de datos (MySQL 8.0) ----------------------------------------------
# Contraseña del usuario root de MySQL (solo para administración)
MYSQL_ROOT_PASSWORD=change-me-root
# Base de datos que se crea al iniciar por primera vez
MYSQL_DATABASE=ecommerce
# Usuario sin privilegios de root que usa la API Laravel
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change-me-app

# --- API Laravel --------------------------------------------------------------
APP_NAME="Ecommerce API"
# Clave de cifrado de Laravel. Genera una con:
#   docker run --rm php:8.2-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Si se deja vacía el contenedor usa una temporal (cambia en cada reinicio).
APP_KEY=
# true solo para depurar; en producción debe ser false
APP_DEBUG=false
# URL pública de la API y del frontend (redirecciones de Stripe, enlaces)
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Nivel de log (debug, info, warning, error)
LOG_LEVEL=warning
# Ejecutar `php artisan migrate --force` al arrancar el contenedor
RUN_MIGRATIONS=true

# Stripe (modo test). Opcional: sin estas claves el catálogo, login y pedidos
# funcionan, pero no el pago.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Frontend Next.js -----------------------------------------------------------
# Cookie de sesión solo por HTTPS. Los navegadores la aceptan también en
# http://localhost. Pon false SOLO para probar desde otra máquina de la red por
# HTTP (y ajusta FRONTEND_URL a http://<IP-del-host>:3000 para Stripe).
COOKIE_SECURE=true

# --- Puertos publicados en el host --------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
